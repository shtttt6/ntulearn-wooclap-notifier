{
  "manifest_version": 3,
  "name": "NTULearn WOOCLAP Notifier",
  "version": "1.5.1",
  "description": "Notifies you when an open WOOCLAP session shows a new answerable question.",
  "minimum_chrome_version": "88",
  "permissions": ["notifications", "storage", "tabs"],
  "host_permissions": ["https://app.wooclap.com/*", "https://ntfy.sh/*", "https://api.day.app/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
    "32": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
    "48": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
    "128": "assets/ntulearn-wooclap-notifier-icon-blue-white.png"
  },
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.wooclap.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/detector-core.js", "src/content-script.js"]
    }
  ],
  "action": {
    "default_title": "NTULearn WOOCLAP Notifier",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
      "32": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
      "48": "assets/ntulearn-wooclap-notifier-icon-blue-white.png",
      "128": "assets/ntulearn-wooclap-notifier-icon-blue-white.png"
    }
  }
}
